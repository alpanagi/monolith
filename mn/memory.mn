import mn

external fn mn_runtime_memory_allocate(size: usize, alignment: usize) -> ?*Many(u8)

external fn mn_runtime_memory_free(pointer: *Many(u8))

const arena_block_size: usize = 4096

error Error
    out_of_memory

typeclass Allocator(type A)
    fn allocate(allocator: *A, type T, count: usize) -> Error![]T
    fn(type T) resize(allocator: *A, items: []T, count: usize) -> bool
    fn(type T) free(allocator: *A, items: []Const(T))
    fn create(allocator: *A, type T) -> Error!*T
        const items = try Allocator::allocate(allocator, T, 1)
        return &items[0]
    fn(type T) destroy(allocator: *A, pointer: *Const(T))
        Allocator::free(allocator, mn::cast(*Many(Const(T)), pointer)[0..1])

fn allocate(type T, count: usize) -> Error![]T
    with allocator
    return allocator.allocate(T, count)

fn(type T) resize(items: []T, count: usize) -> bool
    with allocator
    return allocator.resize(items, count)

fn(type T) free(items: []Const(T))
    with allocator
    allocator.free(items)

fn create(type T) -> Error!*T
    with allocator
    return allocator.create(T)

fn(type T) destroy(pointer: *Const(T))
    with allocator
    allocator.destroy(pointer)

struct Heap
    fn new() -> Self = Self{}

instance Allocator(Heap)
    fn allocate(_: *Heap, type T, count: usize) -> Error![]T
        const pointer = mn_runtime_memory_allocate(mn::size(T) * count, mn::alignment(T)) orelse return Error::out_of_memory
        return mn::cast(*Many(T), pointer)[0..count]

    fn(type T) resize(_: *Heap, items: []T, count: usize) -> bool = count <= items.length

    fn(type T) free(_: *Heap, items: []Const(T)) = mn_runtime_memory_free(mn::cast(*Many(u8), items.pointer))

fn Arena(type P: Allocator) -> type
    return struct
        parent: P
        block: ?*Many(u8)
        used: usize
        capacity: usize
        last: usize

        fn new(parent: P) -> Self = Self{parent = parent, block = null, used = 0, capacity = 0, last = 0}

        fn free_all(self: *Self)
            while self.block as block
                const header = mn::cast(*ArenaBlock, block)
                self.block = header.previous
                self.parent.free(mn::cast(*Many(ArenaBlock), block)[0..header.size / mn::size(ArenaBlock)])
            self.used = 0
            self.capacity = 0
            self.last = 0

struct ArenaBlock
    previous: ?*Many(u8)
    size: usize

instance(type P: Allocator) Allocator(Arena(P))
    fn allocate(arena: *Arena(P), type T, count: usize) -> Error![]T
        const size = mn::size(T) * count
        const alignment = mn::alignment(T)
        if arena.block as block
            const start = mn::align(block + arena.used, alignment)
            const offset = mn::convert(usize, start - block)
            if offset + size <= arena.capacity
                arena.last = offset
                arena.used = offset + size
                return mn::cast(*Many(T), start)[0..count]
        const header_size = mn::size(ArenaBlock)
        var capacity = header_size + size + alignment
        if (capacity < arena_block_size) capacity = arena_block_size
        const blocks = try arena.parent.allocate(ArenaBlock, (capacity + header_size - 1) / header_size)
        capacity = blocks.length * header_size
        const bytes = mn::cast(*Many(u8), blocks.pointer)
        blocks[0] = ArenaBlock{previous = arena.block, size = capacity}
        const start = mn::align(bytes + header_size, alignment)
        const offset = mn::convert(usize, start - bytes)
        arena.block = bytes
        arena.capacity = capacity
        arena.last = offset
        arena.used = offset + size
        return mn::cast(*Many(T), start)[0..count]

    fn(type T) resize(arena: *Arena(P), items: []T, count: usize) -> bool
        if (count <= items.length) return true
        const block = arena.block orelse return false
        const size = mn::size(T) * count
        if (mn::cast(*Many(u8), items.pointer) != block + arena.last or arena.last + size > arena.capacity) return false
        arena.used = arena.last + size
        return true

    fn(type T) free(_: *Arena(P), _: []Const(T)) = noop

fn equal(one: []Const(u8), two: []Const(u8)) -> bool
    if (one.length != two.length) return false
    for index in 0..one.length
        if (one[index] != two[index]) return false
    return true
