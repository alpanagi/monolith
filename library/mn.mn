import mn::math
import mn::memory
import mn::reflection


typeclass Tuple(type T)


typeclass To(type T, type U)
    fn to(value: T, type U) -> !U


typeclass Equal(type T)
    fn equal(one: T, two: T) -> bool


typeclass Hash(type T: Equal)
    fn hash(value: T) -> u64


typeclass Iterator(type I)
    fn Element() -> type
    fn next(iterator: *I) -> ?Element()


struct Range
    start: usize
    end: ?usize


instance Iterator(Range)
    fn Element() -> type = [usize]


    fn next(iterator: *Range) -> ?Element()
        if (iterator.end != null and iterator.start >= iterator.end.?) return null
        const value = iterator.start
        iterator.start += 1
        return {value}


instance(type T) Iterator([]T)
    fn Element() -> type = [T]


    fn next(iterator: *[]T) -> ?Element()
        for element in iterator.*
            iterator.* = iterator.*[1..]
            return {element}
        return null


instance(type T) Iterator([]Const(T))
    fn Element() -> type = [T]


    fn next(iterator: *[]Const(T)) -> ?Element()
        for element in iterator.*
            iterator.* = iterator.*[1..]
            return {element}
        return null


typeclass Zip(type T)
    fn zip(iterators: T) -> Zipped(T)


instance Equal(i8)
    fn equal(one: i8, two: i8) -> bool = one == two


instance Equal(i16)
    fn equal(one: i16, two: i16) -> bool = one == two


instance Equal(i32)
    fn equal(one: i32, two: i32) -> bool = one == two


instance Equal(i64)
    fn equal(one: i64, two: i64) -> bool = one == two


instance Equal(i128)
    fn equal(one: i128, two: i128) -> bool = one == two


instance Equal(isize)
    fn equal(one: isize, two: isize) -> bool = one == two


instance Equal(u8)
    fn equal(one: u8, two: u8) -> bool = one == two


instance Equal(u16)
    fn equal(one: u16, two: u16) -> bool = one == two


instance Equal(u32)
    fn equal(one: u32, two: u32) -> bool = one == two


instance Equal(u64)
    fn equal(one: u64, two: u64) -> bool = one == two


instance Equal(u128)
    fn equal(one: u128, two: u128) -> bool = one == two


instance Equal(usize)
    fn equal(one: usize, two: usize) -> bool = one == two


instance Equal(bool)
    fn equal(one: bool, two: bool) -> bool = one == two


instance Equal([]u8)
    fn equal(one: []u8, two: []u8) -> bool = memory::equal(one, two)


instance Equal([]Const(u8))
    fn equal(one: []Const(u8), two: []Const(u8)) -> bool = memory::equal(one, two)


instance(type A: Equal, comptime N: usize) Equal([N]A)
    fn equal(one: [N]A, two: [N]A) -> bool
        if N == 0
            return true
        else
            for index in 0..N
                if (!Equal::equal(one[index], two[index])) return false
            return true


instance Hash(i8)
    fn hash(value: i8) -> u64 = mix_number(module::truncate(u64, value))


instance Hash(i16)
    fn hash(value: i16) -> u64 = mix_number(module::truncate(u64, value))


instance Hash(i32)
    fn hash(value: i32) -> u64 = mix_number(module::truncate(u64, value))


instance Hash(i64)
    fn hash(value: i64) -> u64 = mix_number(module::truncate(u64, value))


instance Hash(i128)
    fn hash(value: i128) -> u64 = mix_number(module::truncate(u64, value)) ^ mix_number(module::truncate(u64, value >> 64))


instance Hash(isize)
    fn hash(value: isize) -> u64 = mix_number(module::truncate(u64, value))


instance Hash(u8)
    fn hash(value: u8) -> u64 = mix_number(module::convert(u64, value))


instance Hash(u16)
    fn hash(value: u16) -> u64 = mix_number(module::convert(u64, value))


instance Hash(u32)
    fn hash(value: u32) -> u64 = mix_number(module::convert(u64, value))


instance Hash(u64)
    fn hash(value: u64) -> u64 = mix_number(module::convert(u64, value))


instance Hash(u128)
    fn hash(value: u128) -> u64 = mix_number(module::truncate(u64, value)) ^ mix_number(module::truncate(u64, value >> 64))


instance Hash(usize)
    fn hash(value: usize) -> u64 = mix_number(module::convert(u64, value))


instance Hash(bool)
    fn hash(value: bool) -> u64 = mix_number(if (value) 1 else 0)


instance Hash([]u8)
    fn hash(value: []u8) -> u64 = hash_bytes(value)


instance Hash([]Const(u8))
    fn hash(value: []Const(u8)) -> u64 = hash_bytes(value)


instance(type A: Hash, comptime N: usize) Hash([N]A)
    fn hash(value: [N]A) -> u64
        var state: u64 = 0
        for element in value
            state = mix_number(state ^ Hash::hash(element))
        return state


fn mix_number(number: u64) -> u64
    var value = math::add_wrapping(number, 0x9e3779b97f4a7c15)
    value = math::multiply_wrapping(value ^ (value >> 30), 0xbf58476d1ce4e5b9)
    value = math::multiply_wrapping(value ^ (value >> 27), 0x94d049bb133111eb)
    return value ^ (value >> 31)


fn hash_bytes(bytes: []Const(u8)) -> u64
    var state: u64 = 0xcbf29ce484222325
    for byte in bytes
        state = math::multiply_wrapping(state ^ module::convert(u64, byte), 0x100000001b3)
    return mix_number(state)


fn Zipped(type T) -> type
    return struct
        iterators: T


instance(type T: Tuple) Zip(T)
    fn zip(iterators: T) -> Zipped(T) = Zipped(T){iterators = iterators}


instance(type T: Tuple) Iterator(Zipped(T))
    fn Element() -> type = ZippedElement(T, 0)


    fn next(iterator: *Zipped(T)) -> ?Element()
        var element: ZippedElement(T, 0) = undefined
        const filled = fillZipped(T, 0, 0, &iterator.iterators, &element)
        if (filled) return element
        return null


fn ZippedElement(type T, comptime index: usize) -> type
    if (index == reflection::length(T)) return []
    else return reflection::join(Iterator(T[index])::Element(), ZippedElement(T, index + 1))


fn fillZipped(type T, comptime index: usize, comptime offset: usize, iterators: *T, element: *ZippedElement(T, 0)) -> bool
    if (index == reflection::length(T)) return true
    else
        const item = Iterator::next(&iterators.*[index])
        if (item == null) return false
        const Item = Iterator(T[index])::Element()
        copyElements(Item, ZippedElement(T, 0), offset, 0, item.?, element)
        return fillZipped(T, index + 1, offset + reflection::length(Item), iterators, element)


fn copyElements(type S, type D, comptime offset: usize, comptime position: usize, source: S, destination: *D)
    if (position == reflection::length(S)) noop
    else
        destination.*[offset + position] = source[position]
        copyElements(S, D, offset, position + 1, source, destination)


fn List(type T) -> type
    return struct
        items: []T
        capacity: usize

        fn new() -> Self = Self{items = {}, capacity = 0}


        fn append(self: *Self, value: T) -> memory::Error!void
            const length = self.items.length
            if length == self.capacity
                var capacity: usize = 8
                if (self.capacity > 0) capacity = self.capacity * 2
                if self.capacity > 0 and memory::resize(self.items.pointer[0..self.capacity], capacity)
                    self.capacity = capacity
                else
                    const items = try memory::allocate(T, capacity)
                    memory::copy(items[..length], self.items)
                    if (self.capacity > 0) memory::free(self.items.pointer[0..self.capacity])
                    self.items = items[0..length]
                    self.capacity = capacity
            self.items = self.items.pointer[0..length + 1]
            self.items[length] = value


        fn pop(self: *Self) -> ?T
            const length = self.items.length
            if (length == 0) return null
            const value = self.items[length - 1]
            self.items = self.items[0..length - 1]
            return value


        fn deinit(self: *Self)
            if (self.capacity > 0) memory::free(self.items.pointer[0..self.capacity])
            self.items = self.items[0..0]
            self.capacity = 0


fn Set(type T: Hash) -> type
    return struct
        slots: []?T
        length: usize

        fn new() -> Self = Self{slots = {}, length = 0}


        fn insert(self: *Self, value: T) -> memory::Error!bool
            if (self.contains(value)) return false
            if (self.length + 1) * 4 > self.slots.length * 3
                try self.grow()
            self.place(value)
            self.length += 1
            return true


        fn contains(self: Self, value: T) -> bool
            if (self.slots.length == 0) return false
            const mask = self.slots.length - 1
            var index = module::truncate(usize, Hash::hash(value)) & mask
            while self.slots[index] != null
                if (Equal::equal(self.slots[index].?, value)) return true
                index = (index + 1) & mask
            return false


        fn remove(self: *Self, value: T) -> bool
            if (self.slots.length == 0) return false
            const capacity = self.slots.length
            const mask = capacity - 1
            var hole = module::truncate(usize, Hash::hash(value)) & mask
            while self.slots[hole] == null or !Equal::equal(self.slots[hole].?, value)
                if (self.slots[hole] == null) return false
                hole = (hole + 1) & mask
            var next = (hole + 1) & mask
            while self.slots[next] != null
                const home = module::truncate(usize, Hash::hash(self.slots[next].?)) & mask
                if ((next + capacity - home) & mask) >= ((next + capacity - hole) & mask)
                    self.slots[hole] = self.slots[next]
                    hole = next
                next = (next + 1) & mask
            self.slots[hole] = null
            self.length -= 1
            return true


        fn deinit(self: *Self)
            if (self.slots.length > 0) memory::free(self.slots)
            self.slots = self.slots[0..0]
            self.length = 0


        fn grow(self: *Self) -> memory::Error!void
            var capacity: usize = 8
            if (self.slots.length > 0) capacity = self.slots.length * 2
            const slots = try memory::allocate(?T, capacity)
            for (index in 0..capacity) slots[index] = null
            const previous = self.slots
            self.slots = slots
            for slot in previous
                if (slot != null) self.place(slot.?)
            if (previous.length > 0) memory::free(previous)


        fn place(self: *Self, value: T)
            const mask = self.slots.length - 1
            var index = module::truncate(usize, Hash::hash(value)) & mask
            while self.slots[index] != null
                index = (index + 1) & mask
            self.slots[index] = value


instance(type T: Hash) Iterator(Set(T))
    fn Element() -> type = [T]


    fn next(iterator: *Set(T)) -> ?Element()
        for slot in iterator.slots
            iterator.slots = iterator.slots[1..]
            if (slot != null) return {slot.?}
        return null
