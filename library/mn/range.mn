import mn::iterator::Iterable
import mn::iterator::Iterator


struct Range
    start: usize
    end: ?usize


instance Iterable(Range, RangeCursor)

    fn iterator(range: Self) -> RangeCursor = { position = range.start, end = range.end }


struct RangeCursor
    position: usize
    end: ?usize


instance Iterator(RangeCursor, usize)

    fn next(cursor: *Self) -> ?usize
        if (cursor.end != null and cursor.position >= cursor.end.?) return null
        const value = cursor.position
        cursor.position += 1
        return value


instance Iterable(RangeCursor, RangeCursor)

    fn iterator(cursor: Self) -> RangeCursor = cursor
