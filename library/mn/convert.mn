import mn::text::private::parse_float
import mn::text::private::parse_integer


typeclass To(type T, type U)

    fn to(value: T, type U) -> !U


instance To([]const(u8), i8)

    fn to(value: Self, type U) -> !U = parse_integer(U, value)


instance To([]const(u8), i16)

    fn to(value: Self, type U) -> !U = parse_integer(U, value)


instance To([]const(u8), i32)

    fn to(value: Self, type U) -> !U = parse_integer(U, value)


instance To([]const(u8), i64)

    fn to(value: Self, type U) -> !U = parse_integer(U, value)


instance To([]const(u8), i128)

    fn to(value: Self, type U) -> !U = parse_integer(U, value)


instance To([]const(u8), isize)

    fn to(value: Self, type U) -> !U = parse_integer(U, value)


instance To([]const(u8), u8)

    fn to(value: Self, type U) -> !U = parse_integer(U, value)


instance To([]const(u8), u16)

    fn to(value: Self, type U) -> !U = parse_integer(U, value)


instance To([]const(u8), u32)

    fn to(value: Self, type U) -> !U = parse_integer(U, value)


instance To([]const(u8), u64)

    fn to(value: Self, type U) -> !U = parse_integer(U, value)


instance To([]const(u8), u128)

    fn to(value: Self, type U) -> !U = parse_integer(U, value)


instance To([]const(u8), usize)

    fn to(value: Self, type U) -> !U = parse_integer(U, value)


instance To([]const(u8), f16)

    fn to(value: Self, type U) -> !U = parse_float(U, value)


instance To([]const(u8), f32)

    fn to(value: Self, type U) -> !U = parse_float(U, value)


instance To([]const(u8), f64)

    fn to(value: Self, type U) -> !U = parse_float(U, value)


instance To([]const(u8), f128)

    fn to(value: Self, type U) -> !U = parse_float(U, value)


typeclass ToOwned(type T, type U)

    fn to_owned(own value: *T) -> own !U
