import mn
import mn::hash
import mn::math
import mn::range::Range

private external fn mn_runtime_random_entropy -> u64

const Default = Xoshiro256
const entropy = mn_runtime_random_entropy


typeclass Generator(type G)

    fn next(generator: *G) -> u64


    fn range(generator: *G, range: Range) -> usize
        const count = mn::convert(u64, range.end.? - range.start)
        const threshold = math::subtract_wrapping(0, count) % count
        while true
            const bits = Generator::next(generator)
            if (bits >= threshold) return range.start + mn::convert(usize, bits % count)


struct Xoshiro256
    private state: [4]u64

    fn init(seed: u64) -> Self
        var mixer = seed
        return { state = { draw_seed_word(&mixer), draw_seed_word(&mixer), draw_seed_word(&mixer), draw_seed_word(&mixer) } }


instance Generator(Xoshiro256)

    fn next(generator: *Self) -> u64
        const state = &generator.state
        const scaled = math::multiply_wrapping(state[1], 5)
        const result = math::multiply_wrapping((scaled << 7) | (scaled >> 57), 9)
        const shifted = state[1] << 17
        state[2] ^= state[0]
        state[3] ^= state[1]
        state[1] ^= state[2]
        state[0] ^= state[3]
        state[2] ^= shifted
        state[3] = (state[3] << 45) | (state[3] >> 19)
        return result


private fn draw_seed_word(state: *u64) -> u64
    const word = hash::splitmix64(state.*)
    state.* = math::add_wrapping(state.*, 0x9e3779b97f4a7c15)
    return word
