import mn::memory
import mn::memory::Deinit


error Error
    Malformed


typeclass Encode(type T)

    fn encode(value: *const(T), encoder: *Encoder) -> !void


typeclass Encoder(type E)

    fn i8(self: *E, value: i8) -> !void
    fn i16(self: *E, value: i16) -> !void
    fn i32(self: *E, value: i32) -> !void
    fn i64(self: *E, value: i64) -> !void
    fn i128(self: *E, value: i128) -> !void
    fn isize(self: *E, value: isize) -> !void
    fn u8(self: *E, value: u8) -> !void
    fn u16(self: *E, value: u16) -> !void
    fn u32(self: *E, value: u32) -> !void
    fn u64(self: *E, value: u64) -> !void
    fn u128(self: *E, value: u128) -> !void
    fn usize(self: *E, value: usize) -> !void
    fn f16(self: *E, value: f16) -> !void
    fn f32(self: *E, value: f32) -> !void
    fn f64(self: *E, value: f64) -> !void
    fn f128(self: *E, value: f128) -> !void
    fn bool(self: *E, value: bool) -> !void
    fn bytes(self: *E, value: []const(u8)) -> !void
    fn absent(self: *E) -> !void
    fn present(self: *E) -> !void
    fn sequence(self: *E, count: usize) -> !void
    fn map(self: *E, count: usize) -> !void
    fn structure(self: *E, count: usize) -> !void
    fn field(self: *E, name: []const(u8)) -> !void
    fn tuple(self: *E, count: usize) -> !void
    fn variant(self: *E, name: []const(u8), number: usize) -> !void
    fn(type T: Encode) encode(self: *E, value: *const(T)) -> !void


typeclass Decode(type T)

    fn decode(decoder: *Decoder) -> own !T


typeclass Decoder(type D)

    fn i8(self: *D) -> !i8
    fn i16(self: *D) -> !i16
    fn i32(self: *D) -> !i32
    fn i64(self: *D) -> !i64
    fn i128(self: *D) -> !i128
    fn isize(self: *D) -> !isize
    fn u8(self: *D) -> !u8
    fn u16(self: *D) -> !u16
    fn u32(self: *D) -> !u32
    fn u64(self: *D) -> !u64
    fn u128(self: *D) -> !u128
    fn usize(self: *D) -> !usize
    fn f16(self: *D) -> !f16
    fn f32(self: *D) -> !f32
    fn f64(self: *D) -> !f64
    fn f128(self: *D) -> !f128
    fn bool(self: *D) -> !bool
    fn bytes(self: *D) -> own ![]u8
    fn is_present(self: *D) -> !bool
    fn sequence(self: *D) -> !usize
    fn map(self: *D) -> !usize
    fn structure(self: *D, count: usize) -> !void
    fn field(self: *D, name: []const(u8)) -> !void
    fn tuple(self: *D, count: usize) -> !void
    fn variant(self: *D, names: []const([]const(u8))) -> !usize
    fn decode(self: *D, type T: Decode) -> own !T


instance Encode(i8)

    fn encode(value: *const(Self), encoder: *Encoder) -> !void = encoder.i8(value.*)


instance Decode(i8)

    fn decode(decoder: *Decoder) -> own !Self = decoder.i8()


instance Encode(i16)

    fn encode(value: *const(Self), encoder: *Encoder) -> !void = encoder.i16(value.*)


instance Decode(i16)

    fn decode(decoder: *Decoder) -> own !Self = decoder.i16()


