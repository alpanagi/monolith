    fn encode(value: *const(Self), encoder: *E) -> !void = encoder.usize(value.*)


instance(type D: Decoder) Decode(usize, D)

    fn decode(decoder: *D) -> own !Self = decoder.usize()


instance(type E: Encoder) Encode(f16, E)

    fn encode(value: *const(Self), encoder: *E) -> !void = encoder.f16(value.*)


instance(type D: Decoder) Decode(f16, D)

    fn decode(decoder: *D) -> own !Self = decoder.f16()


instance(type E: Encoder) Encode(f32, E)

    fn encode(value: *const(Self), encoder: *E) -> !void = encoder.f32(value.*)


instance(type D: Decoder) Decode(f32, D)

    fn decode(decoder: *D) -> own !Self = decoder.f32()


instance(type E: Encoder) Encode(f64, E)

    fn encode(value: *const(Self), encoder: *E) -> !void = encoder.f64(value.*)


instance(type D: Decoder) Decode(f64, D)

    fn decode(decoder: *D) -> own !Self = decoder.f64()


instance(type E: Encoder) Encode(f128, E)

    fn encode(value: *const(Self), encoder: *E) -> !void = encoder.f128(value.*)


