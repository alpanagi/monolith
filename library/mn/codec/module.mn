    fn encode(value: *const(Self), encoder: *E) -> !void = encoder.u8(value.*)


instance(type D: Decoder) Decode(u8, D)

    fn decode(decoder: *D) -> own !Self = decoder.u8()


instance(type E: Encoder) Encode(u16, E)

    fn encode(value: *const(Self), encoder: *E) -> !void = encoder.u16(value.*)


instance(type D: Decoder) Decode(u16, D)

    fn decode(decoder: *D) -> own !Self = decoder.u16()


instance(type E: Encoder) Encode(u32, E)

    fn encode(value: *const(Self), encoder: *E) -> !void = encoder.u32(value.*)


instance(type D: Decoder) Decode(u32, D)

    fn decode(decoder: *D) -> own !Self = decoder.u32()


instance(type E: Encoder) Encode(u64, E)

    fn encode(value: *const(Self), encoder: *E) -> !void = encoder.u64(value.*)


instance(type D: Decoder) Decode(u64, D)

    fn decode(decoder: *D) -> own !Self = decoder.u64()


instance(type E: Encoder) Encode(u128, E)

    fn encode(value: *const(Self), encoder: *E) -> !void = encoder.u128(value.*)


instance(type D: Decoder) Decode(u128, D)

    fn decode(decoder: *D) -> own !Self = decoder.u128()


