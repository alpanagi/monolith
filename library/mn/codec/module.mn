    fn decode(decoder: *D) -> own !Self = decoder.f128()


instance(type E: Encoder) Encode(bool, E)

    fn encode(value: *const(Self), encoder: *E) -> !void = encoder.bool(value.*)


instance(type D: Decoder) Decode(bool, D)

    fn decode(decoder: *D) -> own !Self = decoder.bool()


instance(type E: Encoder) Encode(*const([]u8), E)

    fn encode(value: *const(Self), encoder: *E) -> !void = encoder.bytes(value.*)


instance(type E: Encoder) Encode(*[]u8, E)

    fn encode(value: *const(Self), encoder: *E) -> !void = encoder.bytes(value.*)


instance(type D: Decoder) Decode(*[]u8, D)

    fn decode(decoder: *D) -> own !Self = decoder.bytes()


instance(type A: Encode(_, E), type E: Encoder) Encode(?A, E)

    fn encode(value: *const(Self), encoder: *E) -> !void
        if value.* as *inner
            try encoder.present()
            try encoder.encode(inner)
        else
            try encoder.absent()


instance(type A: Decode(_, D), type D: Decoder) Decode(?A, D)

    fn decode(decoder: *D) -> own !Self
        if (!try decoder.is_present()) return null
        const own inner = try decoder.decode(A)
        return inner


instance(type A: Encode(_, E), type E: Encoder, comptime N: usize) Encode([N]A, E)

    fn encode(value: *const(Self), encoder: *E) -> !void
        try encoder.sequence(N)
        if N > 0
            for *element in value
                try encoder.encode(element)


instance(type A: Decode(_, D) and Deinit, type D: Decoder, comptime N: usize) Decode([N]A, D)

    fn decode(decoder: *D) -> own !Self
        if (try decoder.sequence() != N) return Error::Malformed
        var own elements: Self = undefined
        if N > 0
            var count: usize = 0
            errdefer drain_elements(A, N, &elements, count)
            while count < N
                const own element = try decoder.decode(A)
                elements[count] = own element
                count += 1
        return elements


private fn drain_elements(type A, comptime N: usize, elements: *[N]A, count: usize)
    for index in 0..count
        var own element = memory::move(&elements[index])
        element.deinit(own)
