    fn decode(decoder: *Decoder) -> own !Self = decoder.bytes()


instance(type A: Encode) Encode(?A)

    fn encode(value: *const(Self), encoder: *Encoder) -> !void
        if value.* as *inner
            try encoder.present()
            try encoder.encode(inner)
        else
            try encoder.absent()


instance(type A: Decode) Decode(?A)

    fn decode(decoder: *Decoder) -> own !Self
        if (!try decoder.is_present()) return null
        const own inner = try decoder.decode(A)
        return inner


instance(type A: Encode, comptime N: usize) Encode([N]A)

    fn encode(value: *const(Self), encoder: *Encoder) -> !void
        try encoder.sequence(N)
        if N > 0
            for *element in value
                try encoder.encode(element)


instance(type A: Decode and Deinit, comptime N: usize) Decode([N]A)

    fn decode(decoder: *Decoder) -> own !Self
        if (try decoder.sequence() != N) return Error::Malformed
        var own elements: Self = undefined
        if N > 0
            var count: usize = 0
            errdefer drain_elements(A, N, &elements, count)
            while count < N
                const own element = try decoder.decode(A)
                elements[count] = own element
                count += 1
        return elements


private fn drain_elements(type A, comptime N: usize, elements: *[N]A, count: usize)
    for index in 0..count
        var own element = memory::move(&elements[index])
        element.deinit(own)
