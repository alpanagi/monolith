import mn
import mn::compare::Ordering
import mn::container
import mn::convert::ToOwned
import mn::memory
import mn::memory::Deinit
import mn::reflection
import mn::reflection::Tuple
import mn::stream::Writer


fn print(writer: *Writer, comptime format: []const(u8), values: Tuple) -> !void = write_format(writer, format, 0, find_brace(format, 0), 0, values)


fn format(comptime pattern: []const(u8), values: Tuple) -> own memory::Error![]u8
    var own list = container::ArrayList(u8)::init()
    errdefer list.deinit(own)
    try print(&list, pattern, values)
    return list.to_owned(own)


fn strip(bytes: []const(u8)) -> []const(u8)
    var start: usize = 0
    var end = bytes.length
    while (start < end and is_whitespace(bytes[start])) start += 1
    while (end > start and is_whitespace(bytes[end - 1])) end -= 1
    return bytes[start..end]


fn is_whitespace(byte: u8) -> bool = match byte
    case (' ', '\t', '\n', '\r', 0x0b, 0x0c) true
    else false


error Error
    Malformed
    OutOfRange


typeclass Parser(type T, type U, type O)

    fn parse(text: T, type U, options: O = {}) -> own !U


struct IntegerOptions
    base: Base = ::Base10


enum Base
    Base2
    Base3
    Base4
    Base5
    Base6
    Base7
    Base8
    Base9
    Base10
    Base11
    Base12
    Base13
    Base14
    Base15
    Base16
    Base17
    Base18
    Base19
    Base20
    Base21
    Base22
    Base23
    Base24
    Base25
    Base26
    Base27
    Base28
    Base29
    Base30
    Base31
    Base32
    Base33
    Base34
    Base35
    Base36
    Prefixed


struct BytesOptions
    base: ?BytesBase = null


enum BytesBase
    Base2
    Base4
    Base8
    Base16
    Base32
    Base64
    Prefixed


instance Parser([]const(u8), i8, IntegerOptions)

    fn parse(text: Self, type U, options: IntegerOptions) -> own !U = parse_integer(U, text, options.base)


instance Parser([]const(u8), i16, IntegerOptions)

    fn parse(text: Self, type U, options: IntegerOptions) -> own !U = parse_integer(U, text, options.base)


instance Parser([]const(u8), i32, IntegerOptions)

    fn parse(text: Self, type U, options: IntegerOptions) -> own !U = parse_integer(U, text, options.base)


instance Parser([]const(u8), i64, IntegerOptions)

    fn parse(text: Self, type U, options: IntegerOptions) -> own !U = parse_integer(U, text, options.base)


instance Parser([]const(u8), i128, IntegerOptions)

    fn parse(text: Self, type U, options: IntegerOptions) -> own !U = parse_integer(U, text, options.base)


instance Parser([]const(u8), isize, IntegerOptions)

    fn parse(text: Self, type U, options: IntegerOptions) -> own !U = parse_integer(U, text, options.base)


instance Parser([]const(u8), u8, IntegerOptions)

    fn parse(text: Self, type U, options: IntegerOptions) -> own !U = parse_integer(U, text, options.base)


instance Parser([]const(u8), u16, IntegerOptions)

    fn parse(text: Self, type U, options: IntegerOptions) -> own !U = parse_integer(U, text, options.base)


instance Parser([]const(u8), u32, IntegerOptions)

    fn parse(text: Self, type U, options: IntegerOptions) -> own !U = parse_integer(U, text, options.base)


instance Parser([]const(u8), u64, IntegerOptions)

    fn parse(text: Self, type U, options: IntegerOptions) -> own !U = parse_integer(U, text, options.base)


instance Parser([]const(u8), u128, IntegerOptions)

    fn parse(text: Self, type U, options: IntegerOptions) -> own !U = parse_integer(U, text, options.base)


instance Parser([]const(u8), usize, IntegerOptions)

    fn parse(text: Self, type U, options: IntegerOptions) -> own !U = parse_integer(U, text, options.base)


instance Parser([]const(u8), f16, [])

    fn parse(text: Self, type U, _: []) -> own !U = parse_float(U, text)


instance Parser([]const(u8), f32, [])

    fn parse(text: Self, type U, _: []) -> own !U = parse_float(U, text)


instance Parser([]const(u8), f64, [])

    fn parse(text: Self, type U, _: []) -> own !U = parse_float(U, text)


instance Parser([]const(u8), f128, [])

    fn parse(text: Self, type U, _: []) -> own !U = parse_float(U, text)


instance Parser([]const(u8), []u8, BytesOptions)

    fn parse(text: Self, type U, options: BytesOptions) -> own !U
        if options.base as base
            return parse_bytes(text, base)
        const own bytes = try memory::allocate(u8, text.length)
        memory::copy(bytes, text)
        return bytes


fn(type Values: Tuple) write_format(writer: *Writer, comptime format: []const(u8), comptime position: usize, comptime brace: usize, comptime index: usize, values: Values) -> !void
    if (brace > position) try Writer::write(writer, format[position..brace])
    if brace == format.length
        if (index < reflection::length(Values)) mn::comptime::error("format has fewer placeholders than values")
    else if brace + 1 < format.length and format[brace + 1] == format[brace]
        try Writer::write(writer, format[brace..brace + 1])
        try write_format(writer, format, brace + 2, find_brace(format, brace + 2), index, values)
    else if format[brace] == '}'
        mn::comptime::error("format has a } without a {, write }} for a brace")
    else if find_close(format, brace) == format.length
        mn::comptime::error("format has a { without a }, write {{ for a brace")
    else if find_specifier(format, brace) == '?'
        mn::comptime::error("format has an unknown placeholder, use {}, {x}, {b} or {s}")
    else if index == reflection::length(Values)
        mn::comptime::error("format has more placeholders than values")
    else
        try write_value(writer, Values[index], find_specifier(format, brace), values[index])
        try write_format(writer, format, find_close(format, brace) + 1, find_brace(format, find_close(format, brace) + 1), index + 1, values)


fn find_brace(format: []const(u8), start: usize) -> usize
    for index in start..format.length
        if (format[index] == '{' or format[index] == '}') return index
    return format.length


fn find_close(format: []const(u8), brace: usize) -> usize
    for index in brace + 1..format.length
        if (format[index] == '}') return index
    return format.length


fn find_specifier(format: []const(u8), brace: usize) -> u8
    const text = format[brace + 1..find_close(format, brace)]
    if (text.length == 0) return 'd'
    if (text.length == 1 and (text[0] == 'x' or text[0] == 'b' or text[0] == 's')) return text[0]
    return '?'


fn write_value(writer: *Writer, type T, comptime specifier: u8, value: T) -> !void
    if T == bool
        if (specifier != 'd') mn::comptime::error("a bool is formatted only with {}")
        if value
            try Writer::write(writer, "true")
        else
            try Writer::write(writer, "false")
    else if T == []u8 or T == []const(u8)
        if specifier == 'x'
            try write_hexadecimal(writer, value)
        else if specifier == 's'
            try Writer::write(writer, value)
        else
            mn::comptime::error("a byte slice is formatted only with {s} or {x}")
    else if T == i8 or T == i16 or T == i32 or T == i64 or T == i128 or T == isize
        if (specifier == 's') mn::comptime::error("an integer is formatted only with {}, {x} or {b}")
        try write_integer(writer, T, true, find_base(specifier), value)
    else if T == u8 or T == u16 or T == u32 or T == u64 or T == u128 or T == usize
        if (specifier == 's') mn::comptime::error("an integer is formatted only with {}, {x} or {b}")
        try write_integer(writer, T, false, find_base(specifier), value)
    else if T == f16 or T == f32 or T == f64 or T == f128
        if (specifier != 'd') mn::comptime::error("a float is formatted only with {}")
        try write_float(writer, T, value)
    else
        mn::comptime::error("only integers, floats, bools and byte slices can be formatted")


fn write_hexadecimal(writer: *Writer, bytes: []const(u8)) -> !void
    var buffer: [64]u8 = undefined
    var position: usize = 0
    for byte in bytes
        buffer[position] = find_digit(byte >> 4)
        buffer[position + 1] = find_digit(byte & 15)
        position += 2
        if position == buffer.length
            try Writer::write(writer, &buffer)
            position = 0
    if (position > 0) try Writer::write(writer, buffer[..position])


fn find_base(specifier: u8) -> u8 = match specifier
    case ('x') 16
    case ('b') 2
    else 10


fn write_integer(writer: *Writer, type T, comptime is_signed: bool, comptime base: u8, value: T) -> !void
    var buffer: [129]u8 = undefined
    var position = buffer.length
    var rest = value
    if is_signed
        if (value > 0) rest = 0 - value
    const radix = mn::convert(T, base)
    while true
        position -= 1
        buffer[position] = find_digit(mn::convert(u8, if (is_signed) 0 - rest % radix else rest % radix))
        rest /= radix
        if (rest == 0) break
    if is_signed
        if value < 0
            position -= 1
            buffer[position] = '-'
    try Writer::write(writer, buffer[position..])


fn find_digit(digit: u8) -> u8
    if (digit < 10) return '0' + digit
    return 'a' + digit - 10


private fn write_float(writer: *Writer, type T, value: T) -> !void
    const one: u128 = 1
    const fraction_bits = find_fraction_bits(T)
    const exponent_bits = find_exponent_bits(T)
    const bits = mn::convert(u128, copy_bits(Bits(T), T, &value))
    const biased = (bits >> fraction_bits) & ((one << exponent_bits) - 1)
    const fraction = bits & ((one << fraction_bits) - 1)
    const is_negative = bits >> (fraction_bits + exponent_bits) != 0
    if biased == (one << exponent_bits) - 1
        if fraction != 0
            try Writer::write(writer, "nan")
        else if is_negative
            try Writer::write(writer, "-inf")
        else
            try Writer::write(writer, "inf")
        return
    var text: [64]u8 = undefined
    var length: usize = 0
    if is_negative
        text[0] = '-'
        length = 1
    if biased == 0 and fraction == 0
        length = append(&text, length, "0.0")
    else
        var digits: [40]u8 = undefined
        const { count, point } = find_shortest_digits(T, biased, fraction, &digits)
        length = place_digits(&text, length, digits[..count], point)
    try Writer::write(writer, text[..length])


private fn find_shortest_digits(type T, biased: u128, fraction: u128, digits: *[40]u8) -> [usize, i64]
    const one: u128 = 1
    const lowest = find_lowest_exponent(T)
    const mantissa = if (biased == 0) fraction else fraction | (one << find_fraction_bits(T))
    const exponent = if (biased == 0) lowest else lowest + mn::convert(i64, biased) - 1
    const factor: u128 = if (biased > 1 and fraction == 0) 4 else 2
    const is_inclusive = mantissa % 2 == 0
    var remainder: Natural(find_capacity(T)) = undefined
    var scale: Natural(find_capacity(T)) = undefined
    var upper: Natural(find_capacity(T)) = undefined
    var lower: Natural(find_capacity(T)) = undefined
    var sum: Natural(find_capacity(T)) = undefined
    remainder.set(mantissa * factor)
    scale.set(factor)
    upper.set(factor / 2)
    lower.set(1)
    if exponent >= 0
        remainder.shift_left(mn::convert(usize, exponent))
        upper.shift_left(mn::convert(usize, exponent))
        lower.shift_left(mn::convert(usize, exponent))
    else
        scale.shift_left(mn::convert(usize, 0 - exponent))

    var point = ((mn::convert(i64, find_bit_count(mantissa)) - 1 + exponent) * 1292913986 >> 32) + 1
    if point >= 0
        scale.multiply_power_of_ten(mn::convert(usize, point))
    else
        remainder.multiply_power_of_ten(mn::convert(usize, 0 - point))
        upper.multiply_power_of_ten(mn::convert(usize, 0 - point))
        lower.multiply_power_of_ten(mn::convert(usize, 0 - point))
    sum.assign_sum(&remainder, &upper)
    while is_past(sum.order(&scale), is_inclusive)
        scale.multiply_small(10)
        point += 1
    while true
        sum.assign_sum(&remainder, &upper)
        sum.multiply_small(10)
        if (is_past(sum.order(&scale), is_inclusive)) break
        remainder.multiply_small(10)
        upper.multiply_small(10)
        lower.multiply_small(10)
        point -= 1

    var count: usize = 0
    while true
        remainder.multiply_small(10)
        upper.multiply_small(10)
        lower.multiply_small(10)
        var digit: u8 = 0
        while remainder.order(&scale) != ::Less
            remainder.subtract(&scale)
            digit += 1
        const is_low = is_past(lower.order(&remainder), is_inclusive)
        sum.assign_sum(&remainder, &upper)
        const is_high = is_past(sum.order(&scale), is_inclusive)
        if is_low and is_high
            remainder.shift_left(1)
            const order = remainder.order(&scale)
            if (order == ::Greater or (order == ::Equal and digit % 2 == 1)) digit += 1
        else if is_high
            digit += 1
        digits[count] = '0' + digit
        count += 1
        if (is_low or is_high) return { count, point }


private fn is_past(order: Ordering, is_inclusive: bool) -> bool = order == ::Greater or (is_inclusive and order == ::Equal)


private fn place_digits(text: *[64]u8, start: usize, digits: []const(u8), point: i64) -> usize
    const count = mn::convert(i64, digits.length)
    if point - 1 < -5 or point - 1 >= 21
        const whole = append(text, append(text, start, digits[..1]), ".")
        const length = if (digits.length == 1) append(text, whole, "0") else append(text, whole, digits[1..])
        return append_exponent(text, length, point - 1)
    if (point <= 0) return append(text, append_zeros(text, append(text, start, "0."), mn::convert(usize, 0 - point)), digits)
    if point < count
        const whole = mn::convert(usize, point)
        return append(text, append(text, append(text, start, digits[..whole]), "."), digits[whole..])
    return append(text, append_zeros(text, append(text, start, digits), mn::convert(usize, point - count)), ".0")


private fn append(text: *[64]u8, start: usize, bytes: []const(u8)) -> usize
    memory::copy(text[start..start + bytes.length], bytes)
    return start + bytes.length


private fn append_zeros(text: *[64]u8, start: usize, count: usize) -> usize
    for (index in start..start + count) text[index] = '0'
    return start + count


private fn append_exponent(text: *[64]u8, start: usize, exponent: i64) -> usize
    var length = append(text, start, if (exponent < 0) "e-" else "e")
    var rest = if (exponent < 0) 0 - exponent else exponent
    var digits: [8]u8 = undefined
    var count: usize = 0
    while true
        digits[count] = '0' + mn::convert(u8, rest % 10)
        rest /= 10
        count += 1
        if (rest == 0) break
    while count > 0
        count -= 1
        text[length] = digits[count]
        length += 1
    return length


private fn parse_integer(type T, text: []const(u8), base: Base) -> Error!T
    const is_negative = text.length > 0 and text[0] == '-'
    const start: usize = if (is_negative) 1 else 0
    const { digits, radix } = find_digits(text[start..], base)
    if (digits.length == 0) return Error::Malformed
    const minimum = find_minimum(T)
    const maximum = ~minimum
    const step = mn::convert(T, radix)
    var value: T = 0
    var is_out_of_range = false
    for byte in digits
        const found = find_value(byte) orelse return Error::Malformed
        if (found >= radix) return Error::Malformed
        const digit = mn::convert(T, found)
        if (is_out_of_range) continue
        if !is_negative
            if value > (maximum - digit) / step
                is_out_of_range = true
            else
                value = value * step + digit
        else if value < (minimum + digit) / step or (minimum == 0 and digit != 0)
            is_out_of_range = true
        else
            value = value * step - digit
    if (is_out_of_range) return Error::OutOfRange
    return value


private fn find_digits(text: []const(u8), base: Base) -> [[]const(u8), u8]
    if (base != ::Prefixed) return { text, find_radix(base) }
    if (text.length < 2 or text[0] != '0') return { text, 10 }
    const radix = find_prefix_radix(text[1]) orelse return { text, 10 }
    return { text[2..], radix }


private fn find_prefix_radix(letter: u8) -> ?u8 = match letter
    case ('x') 16
    case ('o') 8
    case ('b') 2
    else null


private fn find_radix(base: Base) -> u8 = match base
    case (Base2) 2
    case (Base3) 3
    case (Base4) 4
    case (Base5) 5
    case (Base6) 6
    case (Base7) 7
    case (Base8) 8
    case (Base9) 9
    case (Base10) 10
    case (Base11) 11
    case (Base12) 12
    case (Base13) 13
    case (Base14) 14
    case (Base15) 15
    case (Base16) 16
    case (Base17) 17
    case (Base18) 18
    case (Base19) 19
    case (Base20) 20
    case (Base21) 21
    case (Base22) 22
    case (Base23) 23
    case (Base24) 24
    case (Base25) 25
    case (Base26) 26
    case (Base27) 27
    case (Base28) 28
    case (Base29) 29
    case (Base30) 30
    case (Base31) 31
    case (Base32) 32
    case (Base33) 33
    case (Base34) 34
    case (Base35) 35
    case (Base36) 36
    case (Prefixed) 10


private fn parse_bytes(text: []const(u8), base: BytesBase) -> own (Error || memory::Error)![]u8
    if find_bytes_radix(base) as radix
        if (radix == 64) return decode_base64(text)
        return decode_bytes(text, radix)
    if (text.length < 2 or text[0] != '0') return Error::Malformed
    const radix = find_prefix_radix(text[1]) orelse return Error::Malformed
    return decode_bytes(text[2..], radix)


private fn find_bytes_radix(base: BytesBase) -> ?u8 = match base
    case (Base2) 2
    case (Base4) 4
    case (Base8) 8
    case (Base16) 16
    case (Base32) 32
    case (Base64) 64
    case (Prefixed) null


private fn decode_base64(text: []const(u8)) -> own (Error || memory::Error)![]u8
    if (text.length % 4 != 0) return Error::Malformed
    var padding: usize = 0
    if text.length > 0 and text[text.length - 1] == '='
        padding = if (text[text.length - 2] == '=') 2 else 1
    return fill_bytes(text[..text.length - padding], 64)


private fn decode_bytes(text: []const(u8), radix: u8) -> own (Error || memory::Error)![]u8
    if (text.length * find_width(radix) % 8 != 0) return Error::Malformed
    return fill_bytes(text, radix)


private fn fill_bytes(digits: []const(u8), radix: u8) -> own (Error || memory::Error)![]u8
    const width = find_width(radix)
    const own bytes = try memory::allocate(u8, digits.length * width / 8)
    errdefer memory::free(own bytes)
    var buffer: u16 = 0
    var count: usize = 0
    var position: usize = 0
    for digit in digits
        const found = (if (radix == 64) find_base64_value(digit) else find_value(digit)) orelse return Error::Malformed
        if (found >= radix) return Error::Malformed
        buffer = (buffer << width) | mn::convert(u16, found)
        count += width
        if count >= 8
            count -= 8
            bytes[position] = mn::truncate(u8, buffer >> count)
            position += 1
    if ((buffer & ((mn::convert(u16, 1) << count) - 1)) != 0) return Error::Malformed
    return bytes


private fn find_width(radix: u8) -> usize
    var width: usize = 1
    while (mn::convert(u8, 1) << width < radix) width += 1
    return width


private fn find_base64_value(digit: u8) -> ?u8
    if (digit >= 'A' and digit <= 'Z') return digit - 'A'
    if (digit >= 'a' and digit <= 'z') return digit - 'a' + 26
    if (digit >= '0' and digit <= '9') return digit - '0' + 52
    if (digit == '+') return 62
    if (digit == '/') return 63
    return null


private fn find_value(digit: u8) -> ?u8
    if (digit >= '0' and digit <= '9') return digit - '0'
    if (digit >= 'a' and digit <= 'z') return digit - 'a' + 10
    if (digit >= 'A' and digit <= 'Z') return digit - 'A' + 10
    return null


private fn find_minimum(type T) -> T
    if (T == u8 or T == u16 or T == u32 or T == u64 or T == u128 or T == usize) return 0
    return mn::convert(T, 1) << (mn::size(T) * 8 - 1)


private fn parse_float(type T, text: []const(u8)) -> Error!T
    const one: u128 = 1
    const fraction_bits = find_fraction_bits(T)
    const highest = (one << find_exponent_bits(T)) - 1
    if (memory::equal(text, "nan")) return build_float(T, false, highest, one << (fraction_bits - 1))
    if (memory::equal(text, "inf")) return build_float(T, false, highest, 0)
    if (memory::equal(text, "-inf")) return build_float(T, true, highest, 0)

    const is_negative = text.length > 0 and text[0] == '-'
    var position: usize = if (is_negative) 1 else 0
    var number: Natural(find_capacity(T)) = undefined
    number.set(0)
    var chunk: u64 = 0
    var chunk_length: usize = 0
    var kept: usize = 0
    var is_truncated = false
    var exponent: i64 = 0
    var integer_length: usize = 0
    var fraction_length: usize = 0
    var has_point = false
    while position < text.length
        const byte = text[position]
        if byte == '.' and !has_point
            has_point = true
        else if byte >= '0' and byte <= '9'
            if has_point
                fraction_length += 1
                exponent -= 1
            else
                integer_length += 1
            if kept == find_digit_limit(T)
                if (byte != '0') is_truncated = true
                exponent += 1
            else if kept > 0 or byte != '0'
                if chunk_length == 19
                    number.multiply_small(10000000000000000000)
                    number.add_small(chunk)
                    chunk = 0
                    chunk_length = 0
                chunk = chunk * 10 + mn::convert(u64, byte - '0')
                chunk_length += 1
                kept += 1
        else
            break
        position += 1
    if (integer_length == 0 or (has_point and fraction_length == 0)) return Error::Malformed

    var written: i64 = 0
    if position < text.length and (text[position] == 'e' or text[position] == 'E')
        position += 1
        const is_exponent_negative = position < text.length and text[position] == '-'
        if (position < text.length and (text[position] == '-' or text[position] == '+')) position += 1
        const start = position
        while position < text.length and text[position] >= '0' and text[position] <= '9'
            if (written < 1000000000000) written = written * 10 + mn::convert(i64, text[position] - '0')
            position += 1
        if (position == start) return Error::Malformed
        if (is_exponent_negative) written = 0 - written
    if (position != text.length) return Error::Malformed

    if (kept == 0) return build_float(T, is_negative, 0, 0)
    const decimal_exponent = exponent + written
    const magnitude = mn::convert(i64, kept) + decimal_exponent
    if (magnitude > find_largest_magnitude(T)) return Error::OutOfRange
    if (magnitude <= find_smallest_magnitude(T)) return build_float(T, is_negative, 0, 0)
    const exact_power = find_exact_power(T)
    const is_exact = mn::convert(u128, chunk) <= one << (fraction_bits + 1) and decimal_exponent >= 0 - exact_power and decimal_exponent <= exact_power
    if !is_truncated and kept <= 19 and is_exact and magnitude < find_largest_magnitude(T)
        const whole = mn::convert(T, chunk)
        if (decimal_exponent < 0 and is_negative) return -(whole / find_power_of_ten(T, mn::convert(usize, 0 - decimal_exponent)))
        if (decimal_exponent < 0) return whole / find_power_of_ten(T, mn::convert(usize, 0 - decimal_exponent))
        if (is_negative) return -(whole * find_power_of_ten(T, mn::convert(usize, decimal_exponent)))
        return whole * find_power_of_ten(T, mn::convert(usize, decimal_exponent))

    number.multiply_small(find_small_power_of_ten(chunk_length))
    number.add_small(chunk)
    var divisor: Natural(find_capacity(T)) = undefined
    divisor.set(1)
    if decimal_exponent >= 0
        number.multiply_power_of_ten(mn::convert(usize, decimal_exponent))
    else
        divisor.multiply_power_of_ten(mn::convert(usize, 0 - decimal_exponent))
    const shift = mn::convert(i64, fraction_bits + 3 + divisor.count_bits()) - mn::convert(i64, number.count_bits())
    if shift >= 0
        number.shift_left(mn::convert(usize, shift))
    else
        divisor.shift_left(mn::convert(usize, 0 - shift))
    const { quotient, has_remainder } = number.divide(&divisor, fraction_bits + 4)
    return round_float(T, is_negative, quotient, 0 - shift, is_truncated or has_remainder)


private fn round_float(type T, is_negative: bool, quotient: u128, exponent: i64, is_inexact: bool) -> Error!T
    const one: u128 = 1
    const fraction_bits = find_fraction_bits(T)
    const lowest = find_lowest_exponent(T)
    const length = mn::convert(i64, find_bit_count(quotient))
    const top = length - 1 + exponent - mn::convert(i64, fraction_bits)
    const unit = if (top > lowest) top else lowest
    if (unit - exponent > length) return build_float(T, is_negative, 0, 0)
    const dropped = mn::convert(usize, unit - exponent)
    var mantissa = quotient >> dropped
    const rest = quotient & ((one << dropped) - 1)
    const half = one << (dropped - 1)
    if (rest > half or (rest == half and (is_inexact or mantissa % 2 == 1))) mantissa += 1
    const hidden = one << fraction_bits
    if (mantissa < hidden) return build_float(T, is_negative, 0, mantissa)
    const is_carried = mantissa == hidden << 1
    const increment: u128 = if (is_carried) 2 else 1
    const biased = mn::convert(u128, unit - lowest) + increment
    if (biased >= (one << find_exponent_bits(T)) - 1) return Error::OutOfRange
    return build_float(T, is_negative, biased, (if (is_carried) mantissa >> 1 else mantissa) - hidden)


private fn build_float(type T, is_negative: bool, biased: u128, fraction: u128) -> T
    const one: u128 = 1
    const fraction_bits = find_fraction_bits(T)
    const sign: u128 = if (is_negative) one << (fraction_bits + find_exponent_bits(T)) else 0
    const bits = mn::convert(Bits(T), sign | (biased << fraction_bits) | fraction)
    return copy_bits(T, Bits(T), &bits)


private fn find_power_of_ten(type T, exponent: usize) -> T
    var power: T = 1.0
    for (_ in 0..exponent) power *= 10.0
    return power


private fn find_small_power_of_ten(exponent: usize) -> u64
    var power: u64 = 1
    for (_ in 0..exponent) power *= 10
    return power


private fn Bits(type T) -> type
    if (T == f16) return u16
    if (T == f32) return u32
    if (T == f64) return u64
    return u128


private fn copy_bits(type T, type F, value: *const(F)) -> T
    var bits: T = undefined
    memory::copy(mn::cast(*many(u8), &bits)[0..mn::size(T)], mn::cast(*many(const(u8)), value)[0..mn::size(F)])
    return bits


private fn find_fraction_bits(type T) -> usize
    if (T == f16) return 10
    if (T == f32) return 23
    if (T == f64) return 52
    return 112


private fn find_exponent_bits(type T) -> usize
    if (T == f16) return 5
    if (T == f32) return 8
    if (T == f64) return 11
    return 15


private fn find_lowest_exponent(type T) -> i64 = 2 - (mn::convert(i64, 1) << (find_exponent_bits(T) - 1)) - mn::convert(i64, find_fraction_bits(T))


private fn find_digit_limit(type T) -> usize
    if (T == f16) return 23
    if (T == f32) return 114
    if (T == f64) return 769
    return 11565


private fn find_largest_magnitude(type T) -> i64
    if (T == f16) return 5
    if (T == f32) return 39
    if (T == f64) return 309
    return 4933


private fn find_smallest_magnitude(type T) -> i64
    if (T == f16) return -8
    if (T == f32) return -46
    if (T == f64) return -324
    return -4966


private fn find_exact_power(type T) -> i64
    if (T == f16) return 4
    if (T == f32) return 10
    if (T == f64) return 22
    return 48


private fn find_capacity(type T) -> usize
    const digits = mn::convert(usize, mn::convert(i64, find_digit_limit(T)) - find_smallest_magnitude(T))
    return (digits * 3322 / 1000 + find_fraction_bits(T) + 8) / 64 + 4


private fn find_bit_count(value: u128) -> usize
    var rest = value
    var count: usize = 0
    while rest != 0
        rest >>= 1
        count += 1
    return count


private fn Natural(comptime capacity: usize) -> type
    return struct
        limbs: [capacity]u64
        length: usize

        fn set(self: *Self, value: u128)
            self.limbs[0] = mn::truncate(u64, value)
            self.limbs[1] = mn::truncate(u64, value >> 64)
            self.length = 2
            while (self.length > 0 and self.limbs[self.length - 1] == 0) self.length -= 1


        fn assign_sum(self: *Self, one: *const(Self), two: *const(Self))
            const length = if (one.length > two.length) one.length else two.length
            var carry: u64 = 0
            for index in 0..length
                const first: u64 = if (index < one.length) one.limbs[index] else 0
                const second: u64 = if (index < two.length) two.limbs[index] else 0
                const total = mn::convert(u128, first) + mn::convert(u128, second) + mn::convert(u128, carry)
                self.limbs[index] = mn::truncate(u64, total)
                carry = mn::truncate(u64, total >> 64)
            self.length = length
            if carry != 0
                self.limbs[length] = carry
                self.length += 1


        fn shift_left(self: *Self, count: usize)
            if (self.length == 0) return
            const limb_count = count / 64
            const bit_count = count % 64
            if bit_count == 0
                var index = self.length
                while index > 0
                    index -= 1
                    self.limbs[index + limb_count] = self.limbs[index]
            else
                self.limbs[self.length + limb_count] = self.limbs[self.length - 1] >> (64 - bit_count)
                var index = self.length - 1
                while index > 0
                    self.limbs[index + limb_count] = (self.limbs[index] << bit_count) | (self.limbs[index - 1] >> (64 - bit_count))
                    index -= 1
                self.limbs[limb_count] = self.limbs[0] << bit_count
                self.length += 1
            for (index in 0..limb_count) self.limbs[index] = 0
            self.length += limb_count
            if (self.limbs[self.length - 1] == 0) self.length -= 1


        fn multiply_small(self: *Self, factor: u64)
            var carry: u64 = 0
            for index in 0..self.length
                const product = mn::convert(u128, self.limbs[index]) * mn::convert(u128, factor) + mn::convert(u128, carry)
                self.limbs[index] = mn::truncate(u64, product)
                carry = mn::truncate(u64, product >> 64)
            if carry != 0
                self.limbs[self.length] = carry
                self.length += 1


        fn add_small(self: *Self, value: u64)
            var carry = value
            var index: usize = 0
            while carry != 0 and index < self.length
                const total = mn::convert(u128, self.limbs[index]) + mn::convert(u128, carry)
                self.limbs[index] = mn::truncate(u64, total)
                carry = mn::truncate(u64, total >> 64)
                index += 1
            if carry != 0
                self.limbs[self.length] = carry
                self.length += 1


        fn multiply_power_of_ten(self: *Self, exponent: usize)
            var rest = exponent
            while rest >= 19
                self.multiply_small(10000000000000000000)
                rest -= 19
            self.multiply_small(find_small_power_of_ten(rest))


        fn subtract(self: *Self, other: *const(Self))
            var borrow: u64 = 0
            var index: usize = 0
            while index < other.length or borrow != 0
                const part: u64 = if (index < other.length) other.limbs[index] else 0
                const subtrahend = mn::convert(u128, part) + mn::convert(u128, borrow)
                const minuend = mn::convert(u128, self.limbs[index])
                if minuend >= subtrahend
                    self.limbs[index] = mn::truncate(u64, minuend - subtrahend)
                    borrow = 0
                else
                    self.limbs[index] = mn::truncate(u64, minuend + (mn::convert(u128, 1) << 64) - subtrahend)
                    borrow = 1
                index += 1
            while (self.length > 0 and self.limbs[self.length - 1] == 0) self.length -= 1


        fn divide(self: *Self, divisor: *Self, bits: usize) -> [u128, bool]
            divisor.shift_left(bits - 1)
            var quotient: u128 = 0
            for _ in 0..bits
                quotient <<= 1
                if self.order(divisor) != ::Less
                    self.subtract(divisor)
                    quotient |= 1
                self.shift_left(1)
            return { quotient, self.length != 0 }


        fn order(self: *const(Self), other: *const(Self)) -> Ordering
            if (self.length < other.length) return ::Less
            if (self.length > other.length) return ::Greater
            var index = self.length
            while index > 0
                index -= 1
                if (self.limbs[index] < other.limbs[index]) return ::Less
                if (self.limbs[index] > other.limbs[index]) return ::Greater
            return ::Equal


        fn count_bits(self: *const(Self)) -> usize
            if (self.length == 0) return 0
            return (self.length - 1) * 64 + find_bit_count(mn::convert(u128, self.limbs[self.length - 1]))
