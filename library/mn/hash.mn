import mn
import mn::compare::Equal
import mn::math
import mn::memory
import mn::stream::Reader

const block_size: usize = 64
const buffer_size: usize = 65536
const initial_state: [8]u32 = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 }


const round_constants: [64]u32 = {
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
}


typeclass Hash(type T: Equal)

    fn hash(value: *const(T)) -> u64


instance Hash(i8)

    fn hash(value: *const(Self)) -> u64 = splitmix64(mn::truncate(u64, value.*))


instance Hash(i16)

    fn hash(value: *const(Self)) -> u64 = splitmix64(mn::truncate(u64, value.*))


instance Hash(i32)

    fn hash(value: *const(Self)) -> u64 = splitmix64(mn::truncate(u64, value.*))


instance Hash(i64)

    fn hash(value: *const(Self)) -> u64 = splitmix64(mn::truncate(u64, value.*))


instance Hash(i128)

    fn hash(value: *const(Self)) -> u64 = splitmix64(mn::truncate(u64, value.*)) ^ splitmix64(mn::truncate(u64, value.* >> 64))


instance Hash(isize)

    fn hash(value: *const(Self)) -> u64 = splitmix64(mn::truncate(u64, value.*))


instance Hash(u8)

    fn hash(value: *const(Self)) -> u64 = splitmix64(mn::convert(u64, value.*))


instance Hash(u16)

    fn hash(value: *const(Self)) -> u64 = splitmix64(mn::convert(u64, value.*))


instance Hash(u32)

    fn hash(value: *const(Self)) -> u64 = splitmix64(mn::convert(u64, value.*))


instance Hash(u64)

    fn hash(value: *const(Self)) -> u64 = splitmix64(mn::convert(u64, value.*))


instance Hash(u128)

    fn hash(value: *const(Self)) -> u64 = splitmix64(mn::truncate(u64, value.*)) ^ splitmix64(mn::truncate(u64, value.* >> 64))


instance Hash(usize)

    fn hash(value: *const(Self)) -> u64 = splitmix64(mn::convert(u64, value.*))


instance Hash(bool)

    fn hash(value: *const(Self)) -> u64 = splitmix64(if (value.*) 1 else 0)


instance Hash([]const(u8))

    fn hash(value: *const(Self)) -> u64 = splitmix64(fnv1a64(value.*))


instance Hash([]u8)

    fn hash(value: *const(Self)) -> u64 = splitmix64(fnv1a64(value.*))


instance(type A: Hash, comptime N: usize) Hash([N]A)

    fn hash(value: *const(Self)) -> u64
        var state: u64 = 0
        for *element in value.*
            state = splitmix64(state ^ Hash::hash(element))
        return state


fn splitmix64(number: u64) -> u64
    var value = math::add_wrapping(number, 0x9e3779b97f4a7c15)
    value = math::multiply_wrapping(value ^ (value >> 30), 0xbf58476d1ce4e5b9)
    value = math::multiply_wrapping(value ^ (value >> 27), 0x94d049bb133111eb)
    return value ^ (value >> 31)


fn fnv1a64(bytes: []const(u8)) -> u64
    var state: u64 = 0xcbf29ce484222325
    for byte in bytes
        state = math::multiply_wrapping(state ^ mn::convert(u64, byte), 0x100000001b3)
    return state


fn sha256(reader: *Reader) -> ![32]u8
    var state = initial_state
    var buffer: [buffer_size]u8 = undefined
    var filled: usize = 0
    var total: u64 = 0
    while true
        const count = try Reader::read(reader, buffer[filled..])
        if (count == 0) break
        total += mn::convert(u64, count)
        filled += count
        var position: usize = 0
        while filled - position >= block_size
            compress(&state, buffer[position..position + block_size])
            position += block_size
        memory::copy(buffer[..filled - position], buffer[position..filled])
        filled -= position
    buffer[filled] = 0x80
    filled += 1
    if filled > block_size - 8
        for (index in filled..block_size) buffer[index] = 0
        compress(&state, buffer[..block_size])
        filled = 0
    for (index in filled..block_size - 8) buffer[index] = 0
    const bits = total << 3
    for (index in 0..8) buffer[block_size - 8 + index] = mn::truncate(u8, bits >> (56 - index * 8))
    compress(&state, buffer[..block_size])
    var digest: [32]u8 = undefined
    for index in 0..32
        digest[index] = mn::truncate(u8, state[index / 4] >> (24 - index % 4 * 8))
    return digest


fn compress(state: *[8]u32, block: []const(u8))
    var schedule: [64]u32 = undefined
    for index in 0..16
        const start = index * 4
        const high = (mn::convert(u32, block[start]) << 24) | (mn::convert(u32, block[start + 1]) << 16)
        schedule[index] = high | (mn::convert(u32, block[start + 2]) << 8) | mn::convert(u32, block[start + 3])
    for index in 16..64
        const far = schedule[index - 15]
        const near = schedule[index - 2]
        const small_far = rotate(far, 7) ^ rotate(far, 18) ^ (far >> 3)
        const small_near = rotate(near, 17) ^ rotate(near, 19) ^ (near >> 10)
        const sum = math::add_wrapping(schedule[index - 16], small_far)
        schedule[index] = math::add_wrapping(math::add_wrapping(sum, schedule[index - 7]), small_near)
    var work = state.*
    for index in 0..64
        const large_four = rotate(work[4], 6) ^ rotate(work[4], 11) ^ rotate(work[4], 25)
        const choice = (work[4] & work[5]) ^ (~work[4] & work[6])
        const added = math::add_wrapping(math::add_wrapping(work[7], large_four), choice)
        const first = math::add_wrapping(math::add_wrapping(added, round_constants[index]), schedule[index])
        const large_zero = rotate(work[0], 2) ^ rotate(work[0], 13) ^ rotate(work[0], 22)
        const majority = (work[0] & work[1]) ^ (work[0] & work[2]) ^ (work[1] & work[2])
        const second = math::add_wrapping(large_zero, majority)
        work[7] = work[6]
        work[6] = work[5]
        work[5] = work[4]
        work[4] = math::add_wrapping(work[3], first)
        work[3] = work[2]
        work[2] = work[1]
        work[1] = work[0]
        work[0] = math::add_wrapping(first, second)
    for (index in 0..8) state[index] = math::add_wrapping(state[index], work[index])


fn rotate(value: u32, count: usize) -> u32 = (value >> count) | (value << (32 - count))
