import mn::iterator::SliceIterator
import mn::memory


typeclass Reader(type R)

    fn read(reader: *R, buffer: *[]u8) -> !usize


typeclass Writer(type W)

    fn write(writer: *W, bytes: const(*[]u8)) -> !void


instance Reader(SliceIterator(const(*[]u8)))

    fn read(source: *Self, buffer: *[]u8) -> !usize
        var count = source.remaining.length
        if (buffer.length < count) count = buffer.length
        memory::copy(buffer[..count], source.remaining[..count])
        source.remaining = source.remaining[count..]
        return count


instance Reader(SliceIterator(*[]u8))

    fn read(source: *Self, buffer: *[]u8) -> !usize
        var count = source.remaining.length
        if (buffer.length < count) count = buffer.length
        memory::copy(buffer[..count], source.remaining[..count])
        source.remaining = source.remaining[count..]
        return count


fn BufferedReader(type R: Reader) -> type
    return struct
        private reader: *R
        private buffer: *[]u8
        private start: usize
        private end: usize

        fn init(reader: *R, buffer: *[]u8) -> Self = { reader = reader, buffer = buffer, start = 0, end = 0 }


instance(type R: Reader) Reader(BufferedReader(R))

    fn read(self: *Self, destination: *[]u8) -> !usize
        if (destination.length == 0) return 0
        if self.start == self.end
            if (destination.length >= self.buffer.length) return Reader::read(self.reader, destination)
            const filled = try Reader::read(self.reader, self.buffer)
            if (filled == 0) return 0
            self.start = 0
            self.end = filled
        var count = self.end - self.start
        if (destination.length < count) count = destination.length
        memory::copy(destination[..count], self.buffer[self.start..self.start + count])
        self.start += count
        return count
