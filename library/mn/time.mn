import mn::codec::Decode
import mn::codec::Decoder
import mn::codec::Encode
import mn::codec::Encoder
import mn::codec::binary
import mn::codec::yaml
import mn::compare::Equal
import mn::compare::Order
import mn::compare::Ordering
import mn::stream::Reader
import mn::stream::Writer

private external fn mn_runtime_time_wall_clock(seconds: *i64, nanoseconds: *u32)
private external fn mn_runtime_time_monotonic_clock -> i64


struct WallTime
    seconds: i64
    nanoseconds: u32

    fn now -> Self
        var reading: Self = { seconds = 0, nanoseconds = 0 }
        mn_runtime_time_wall_clock(&reading.seconds, &reading.nanoseconds)
        return reading


instance(type W: Writer) Encode(WallTime, binary::BinaryEncoder(W))

    fn encode(wall_time: *const(Self), encoder: *binary::BinaryEncoder(W)) -> !void
        try encoder.i64(wall_time.seconds)
        try encoder.u32(wall_time.nanoseconds)


instance(type R: Reader) Decode(WallTime, binary::BinaryDecoder(R))

    fn decode(decoder: *binary::BinaryDecoder(R)) -> own !Self
        const seconds = try decoder.i64()
        const nanoseconds = try decoder.u32()
        return { seconds = seconds, nanoseconds = nanoseconds }


instance(type W: Writer) Encode(WallTime, yaml::YamlEncoder(W))

    fn encode(wall_time: *const(Self), encoder: *yaml::YamlEncoder(W)) -> !void
        try encoder.structure(2)
        try encoder.field("seconds")
        try encoder.encode(&wall_time.seconds)
        try encoder.field("nanoseconds")
        try encoder.encode(&wall_time.nanoseconds)


instance Decode(WallTime, yaml::YamlDecoder)

    fn decode(decoder: *yaml::YamlDecoder) -> own !Self
        try decoder.structure(2)
        try decoder.field("seconds")
        const seconds = try decoder.decode(i64)
        try decoder.field("nanoseconds")
        const nanoseconds = try decoder.decode(u32)
        return { seconds = seconds, nanoseconds = nanoseconds }


instance Equal(WallTime)

    fn equal(one: *const(Self), two: *const(Self)) -> bool = one.seconds == two.seconds and one.nanoseconds == two.nanoseconds


instance Order(WallTime)

    fn order(one: *const(Self), two: *const(Self)) -> Ordering
        const seconds = one.seconds.order(&two.seconds)
        if (seconds != ::Equal) return seconds
        return one.nanoseconds.order(&two.nanoseconds)


struct MonotonicTime
    nanoseconds: i64

    fn now -> Self = { nanoseconds = mn_runtime_time_monotonic_clock() }


instance Equal(MonotonicTime)

    fn equal(one: *const(Self), two: *const(Self)) -> bool = one.nanoseconds == two.nanoseconds


instance Order(MonotonicTime)

    fn order(one: *const(Self), two: *const(Self)) -> Ordering = one.nanoseconds.order(&two.nanoseconds)
