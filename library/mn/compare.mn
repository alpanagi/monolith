import mn::memory


typeclass Equal(type T)

    fn equal(one: const(*T), two: const(*T)) -> bool


instance Equal(i8)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = one.* == two.*


instance Equal(i16)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = one.* == two.*


instance Equal(i32)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = one.* == two.*


instance Equal(i64)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = one.* == two.*


instance Equal(i128)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = one.* == two.*


instance Equal(isize)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = one.* == two.*


instance Equal(u8)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = one.* == two.*


instance Equal(u16)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = one.* == two.*


instance Equal(u32)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = one.* == two.*


instance Equal(u64)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = one.* == two.*


instance Equal(u128)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = one.* == two.*


instance Equal(usize)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = one.* == two.*


instance Equal(bool)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = one.* == two.*


instance Equal(const(*[]u8))

    fn equal(one: const(*Self), two: const(*Self)) -> bool = memory::equal(one.*, two.*)


instance Equal(*[]u8)

    fn equal(one: const(*Self), two: const(*Self)) -> bool = memory::equal(one.*, two.*)


instance(type A: Equal, comptime N: usize) Equal([N]A)

    fn equal(one: const(*Self), two: const(*Self)) -> bool
        if N == 0
            return true
        else
            for index in 0..N
                if (!Equal::equal(&one.*[index], &two.*[index])) return false
            return true


typeclass Order(type T: Equal)

    fn order(one: const(*T), two: const(*T)) -> Ordering

    fn is_less_than(one: const(*T), two: const(*T)) -> bool = Order::order(one, two) == ::Less
    fn is_greater_than(one: const(*T), two: const(*T)) -> bool = Order::order(one, two) == ::Greater


enum Ordering
    Less
    Equal
    Greater


instance Order(i8)

    fn order(one: const(*Self), two: const(*Self)) -> Ordering
        if (one.* < two.*) return ::Less
        if (one.* > two.*) return ::Greater
        return ::Equal


instance Order(i16)

    fn order(one: const(*Self), two: const(*Self)) -> Ordering
        if (one.* < two.*) return ::Less
        if (one.* > two.*) return ::Greater
        return ::Equal


instance Order(i32)

    fn order(one: const(*Self), two: const(*Self)) -> Ordering
        if (one.* < two.*) return ::Less
        if (one.* > two.*) return ::Greater
        return ::Equal


instance Order(i64)

    fn order(one: const(*Self), two: const(*Self)) -> Ordering
        if (one.* < two.*) return ::Less
        if (one.* > two.*) return ::Greater
        return ::Equal


instance Order(i128)

    fn order(one: const(*Self), two: const(*Self)) -> Ordering
        if (one.* < two.*) return ::Less
        if (one.* > two.*) return ::Greater
        return ::Equal


