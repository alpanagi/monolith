instance Order(const(*[]u8))

    fn order(one: const(*Self), two: const(*Self)) -> Ordering = order_bytes(one.*, two.*)


instance Order(*[]u8)

    fn order(one: const(*Self), two: const(*Self)) -> Ordering = order_bytes(one.*, two.*)


private fn order_bytes(one: const(*[]u8), two: const(*[]u8)) -> Ordering
    const length = if (one.length < two.length) one.length else two.length
    for index in 0..length
        if (one[index] < two[index]) return ::Less
        if (one[index] > two[index]) return ::Greater
    if (one.length < two.length) return ::Less
    if (one.length > two.length) return ::Greater
    return ::Equal
