import mn::reflection
import mn::reflection::Tuple


typeclass Iterator(type I, type E)

    fn next(iterator: *I) -> ?E


typeclass Iterable(type T, type I)

    fn iterator(value: T) -> I


instance(type I: Iterator(_, E), type E) Iterable(I, I)

    fn iterator(iterator: Self) -> Self = iterator


instance(type T) Iterable(*[]T, SliceIterator(*[]T))

    fn iterator(items: Self) -> SliceIterator(*[]T) = { remaining = items }


instance(type T) Iterable(const(*[]T), SliceIterator(const(*[]T)))

    fn iterator(items: Self) -> SliceIterator(const(*[]T)) = { remaining = items }


fn SliceIterator(type S) -> type
    return inline struct
        remaining: S


instance(type T) Iterator(SliceIterator(*[]T), *T)

    fn next(iterator: *Self) -> ?*T
        if (iterator.remaining.length == 0) return null
        const element = &iterator.remaining[0]
        iterator.remaining = iterator.remaining[1..]
        return element


instance(type T) Iterator(SliceIterator(const(*[]T)), const(*T))

    fn next(iterator: *Self) -> ?const(*T)
        if (iterator.remaining.length == 0) return null
        const element = &iterator.remaining[0]
        iterator.remaining = iterator.remaining[1..]
        return element


typeclass Zip(type T)

    fn zip(iterables: T) -> Zipped(T)


fn Zipped(type T) -> type
    return struct
        private cursors: Cursors(T, 0)


private fn Cursors(type T, comptime index: usize) -> type
    if (index == reflection::length(T)) return []
    else return reflection::join([IterableCursor(T[index])], Cursors(T, index + 1))


private fn(type C) IterableCursor(type T: Iterable(_, C)) -> type = C


instance(type T: Tuple) Zip(T)

    fn zip(iterables: Self) -> Zipped(Self)
        var zipped: Zipped(Self) = undefined
        fill_cursors(Self, 0, iterables, &zipped.cursors)
        return zipped


private fn fill_cursors(type T, comptime index: usize, iterables: T, cursors: *Cursors(T, 0))
    if (index == reflection::length(T)) noop
    else
        cursors.*[index] = Iterable::iterator(iterables[index])
        fill_cursors(T, index + 1, iterables, cursors)


instance(type T: Tuple) Iterator(Zipped(T), ZippedElement(T))

    fn next(zipped: *Self) -> ?ZippedElement(T)
        var element: ZippedElement(T) = undefined
        const filled = fill_zipped(Cursors(T, 0), 0, &zipped.cursors, &element)
        if (filled) return element
        return null


fn ZippedElement(type T) -> type = CursorElements(Cursors(T, 0), 0)


private fn CursorElements(type C, comptime index: usize) -> type
    if (index == reflection::length(C)) return []
    else return reflection::join([IteratorElement(C[index])], CursorElements(C, index + 1))


private fn(type E) IteratorElement(type I: Iterator(_, E)) -> type = E


private fn fill_zipped(type C, comptime index: usize, cursors: *C, element: *CursorElements(C, 0)) -> bool
    if (index == reflection::length(C)) return true
    else
        const item = Iterator::next(&cursors.*[index])
        if (item == null) return false
        element.*[index] = item.?
        return fill_zipped(C, index + 1, cursors, element)
